# このファイルを .env.local にコピーして値を入れる。.env.local はコミットしない。
# Claude API のキー（サーバー側だけで使う。未設定なら読み取り機能は止まり、ほかの機能は動く）
ANTHROPIC_API_KEY=

# 使いすぎ対策（未設定ならコード内の既定値）
# 1つの接続元が1時間に呼べる回数
RATE_LIMIT_PER_HOUR=10
# サーバー全体で1日に呼べる回数
RATE_LIMIT_GLOBAL_PER_DAY=200

# off にすると、デモの家族のときは「つなぐ」「聞く」で Claude を呼ばない（仮のものを出す）
CONNECT_DEMO=

# ---- Telegram の通訳と毎朝の通知（無ければ、その部分だけ「準備中」になる）----
# Telegram の bot のトークン（BotFather で作る。グループの会話を全部訳すので、プライバシーモードは切る）
TELEGRAM_BOT_TOKEN=
# webhook が本物の Telegram から来たかを確かめる合言葉（好きな文字列。/api/telegram/setup?key=この値 を一度だけ開いて登録する）
TELEGRAM_WEBHOOK_SECRET=
# Firebase のサービスアカウント（JSON を1行で）。置くのは、グループの人の読みたい言葉・合言葉の指紋・近い予定の日付と件数だけ
FIREBASE_SERVICE_ACCOUNT=
# Telegram の通訳・返信の答えで Claude を呼べる回数（日本時間の1日あたり。未設定なら 1グループ100回・全体300回）
TELEGRAM_CLAUDE_PER_CHAT_PER_DAY=
TELEGRAM_CLAUDE_GLOBAL_PER_DAY=
# 毎朝の通知（vercel.json の定時実行）が本物の Vercel から来たかを確かめる合言葉（英数字32文字くらい）
CRON_SECRET=
